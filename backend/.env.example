# App Configuration
PROJECT_NAME="SiTernak API"
ENVIRONMENT=development
SECRET_KEY=change_this_secret_key_to_a_secure_random_string_in_production
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User (Seeder)
INITIAL_USER_USERNAME=admin
INITIAL_USER_PASSWORD=admin123

# CORS Origins (Comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection Components (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=siternak_db

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optional: Full URL override (uncomment if using single connection URI)
# CUSTOM_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/siternak_db
